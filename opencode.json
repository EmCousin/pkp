{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "mcp": {
    "rollbar": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@rollbar/mcp-server@0.6.0"
      ],
      "environment": {
        "ROLLBAR_ACCESS_TOKEN": "{env:ROLLBAR_MCP_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@yawlabs/postgres-mcp@0.10.0"
      ],
      "environment": {
        "DATABASE_URL": "{env:READ_ONLY_DATABASE_URL}",
        "POSTGRES_MCP_RUNTIME": "node"
      },
      "enabled": true
    }
  }
}
