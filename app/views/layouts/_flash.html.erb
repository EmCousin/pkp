<div id="flash-messages" class="fixed inset-x-0 bottom-0 z-50 space-y-2 md:ml-auto md:w-1/2 md:mb-4 md:mr-4">
  <% if alert.present? %>
    <details open class="group relative min-h-10 animate-slide-in-up-out-down hover:[animation-play-state:paused] focus-within:[animation-play-state:paused] motion-reduce:animate-hide-after-delay">
      <summary aria-describedby="flash-alert-message" class="absolute right-2 top-2 z-10 cursor-pointer list-none rounded-md px-2 py-1 text-sm font-medium text-yellow-700 hover:bg-yellow-100 focus:outline-none focus:ring-2 focus:ring-yellow-700 focus:ring-offset-2 focus:ring-offset-yellow-50 [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden"><%= t('defaults.show') %></span>
        <span class="hidden group-open:inline"><%= t('defaults.dismiss') %></span>
      </summary>
      <div class="flex items-center bg-yellow-50 rounded-lg shadow-sm px-4 py-3 pr-24" role="alert">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg aria-hidden="true" class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58 - 9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-yellow-700" id="flash-alert-message"><%= alert %></p>
          </div>
        </div>
      </div>
    </details>
  <% end %>

  <% if notice.present? %>
    <details open class="group relative min-h-10 animate-slide-in-up-out-down hover:[animation-play-state:paused] focus-within:[animation-play-state:paused] motion-reduce:animate-hide-after-delay">
      <summary aria-describedby="flash-notice-message" class="absolute right-2 top-2 z-10 cursor-pointer list-none rounded-md px-2 py-1 text-sm font-medium text-blue-700 hover:bg-blue-100 focus:outline-none focus:ring-2 focus:ring-blue-700 focus:ring-offset-2 focus:ring-offset-blue-50 [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden"><%= t('defaults.show') %></span>
        <span class="hidden group-open:inline"><%= t('defaults.dismiss') %></span>
      </summary>
      <div class="flex items-center bg-blue-50 rounded-lg shadow-sm px-4 py-3 pr-24" role="status">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg aria-hidden="true" class="h-5 w-5 text-blue-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-blue-700" id="flash-notice-message"><%= notice %></p>
          </div>
        </div>
      </div>
    </details>
  <% end %>

  <% if current_user&.invalid_email_provider? %>
    <details open class="group relative min-h-10 animate-slide-in-up-out-down hover:[animation-play-state:paused] focus-within:[animation-play-state:paused] motion-reduce:animate-hide-after-delay">
      <summary aria-describedby="flash-email-warning-message" class="absolute right-2 top-2 z-10 cursor-pointer list-none rounded-md px-2 py-1 text-sm font-medium text-red-700 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-700 focus:ring-offset-2 focus:ring-offset-red-50 [&::-webkit-details-marker]:hidden">
        <span class="group-open:hidden"><%= t('defaults.show') %></span>
        <span class="hidden group-open:inline"><%= t('defaults.dismiss') %></span>
      </summary>
      <div class="flex items-center bg-red-50 rounded-lg shadow-sm px-4 py-3 pr-24" role="status">
        <div class="flex items-center">
          <div class="flex-shrink-0">
            <svg aria-hidden="true" class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3">
            <p class="text-sm text-red-700" id="flash-email-warning-message"><%= t('.invalid_email_provider', email: current_user.email) %></p>
          </div>
        </div>
      </div>
    </details>
  <% end %>
</div>
