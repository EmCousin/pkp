<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h1 class="mt-6 text-center text-3xl font-extrabold text-amber-500"><%= t('.title') %></h1>
      <div class="mt-2 border-b border-gray-300"></div>
    </div>

    <%= form_with model: @user, scope: :user, url: user_password_path, id: "new_user", skip_default_ids: false, class: "mt-8 space-y-6" do |form| %>
      <div>
        <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true,
                             class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
      </div>
      <%= form.submit t('.submit'), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900" %>
    <% end %>

    <div class="mt-6"><%= render 'auth/shared/links' %></div>
  </div>
</div>
