<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8">
    <div>
      <h1 class="mt-6 text-center text-3xl font-extrabold text-amber-500"><%= t('.title') %></h1>
      <div class="mt-2 border-b border-gray-300"></div>
    </div>

    <%= form_with model: @user, scope: :user, url: user_registration_path, method: :put, id: "edit_user", skip_default_ids: false, class: "mt-8 space-y-6" do |form| %>
      <%= render 'auth/shared/error_messages', user: @user %>

      <div class="space-y-6">
        <div>
          <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :first_name, autocomplete: "given-name", class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <%= form.error_for :first_name, full_messages: true %>
        </div>

        <div>
          <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :last_name, autocomplete: "family-name", class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <%= form.error_for :last_name, full_messages: true %>
        </div>

        <div>
          <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <%= form.error_for :email, full_messages: true %>
        </div>

        <div>
          <%= form.label :phone_number, class: "block text-sm font-medium text-gray-700" %>
          <%= form.telephone_field :phone_number, class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <%= form.error_for :phone_number, full_messages: true %>
        </div>

        <div>
          <%= form.label :address, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :address, class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <%= form.error_for :address, full_messages: true %>
        </div>

        <div>
          <%= form.label :zip_code, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :zip_code, class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <%= form.error_for :zip_code, full_messages: true %>
        </div>

        <div>
          <%= form.label :city, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :city, class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <%= form.error_for :city, full_messages: true %>
        </div>

        <div>
          <%= form.label :country, class: "block text-sm font-medium text-gray-700" %>
          <%= form.collection_select :country, countries_by_name, :code, :name, { include_blank: true },
                                     required: true,
                                     id: 'user_country',
                                     class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm bg-white" %>
          <%= form.error_for :country, full_messages: true %>
        </div>

        <div>
          <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :password, autocomplete: "new-password", maxlength: User::PASSWORD_MAXIMUM_LENGTH,
                                  class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <p class="mt-2 text-sm text-gray-500"><%= t('.leave_blank_if_you_wont_change_it') %></p>
          <%= form.error_for :password, full_messages: true %>
        </div>

        <div>
          <%= form.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <%= form.error_for :password_confirmation, full_messages: true %>
        </div>

        <div>
          <%= form.label :current_password, class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :current_password, autocomplete: "current-password", required: true,
                                  class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <p class="mt-2 text-sm text-gray-500"><%= t('.current_password_needed') %></p>
          <%= form.error_for :current_password, full_messages: true %>
        </div>

        <%= form.submit t('defaults.save'), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-800" %>
      </div>
    <% end %>

    <div class="pt-4 border-t border-gray-200">
      <h2 class="text-lg font-medium text-gray-900"><%= t('.delete_my_account') %></h2>
      <div class="text-sm mt-2 p-4 mb-4 text-red-700 bg-red-100 rounded-lg" role="alert">
        <p><%= t('.warning_cannot_be_undone') %></p>
        <% if @user.destroyable? %>
          <%= link_to t('.delete_my_account'), delete_user_registration_path,
                      class: "mt-2 flex items-center w-full px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
        <% else %>
          <p class="mt-2"><%= t('.finalized_event_registration') %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
