<div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-6 bg-white p-8 rounded-lg">
    <h1 class="text-2xl font-bold text-red-700"><%= t('.title') %></h1>
    <p><%= t('.warning') %></p>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= button_to t('.confirm'), user_registration_path, method: :delete,
                    class: "w-full px-4 py-2 rounded-md bg-red-600 text-white hover:bg-red-700" %>
      <%= link_to t('defaults.cancel'), edit_user_registration_path,
                  class: "w-full px-4 py-2 rounded-md border border-gray-300 text-center text-gray-700 hover:bg-gray-50" %>
    </div>
  </div>
</div>
