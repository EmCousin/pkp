<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white p-8 rounded-lg">
    <div>
      <h1 class="mt-6 text-center text-3xl font-extrabold text-amber-500">
        <%= t('.signup') %>
      </h1>
      <div class="mt-2 border-b border-gray-300"></div>
    </div>

    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-4">
      <% if full? %>
        <h3 class="text-lg font-medium text-yellow-800 text-center mb-2"><%= t('.full') %></h3>
        <div class="border-t border-yellow-200 my-2"></div>
        <p class="text-yellow-700 text-sm"><%= t('.reopen_when_available') %></p>
      <% elsif vacation_time? %>
        <h3 class="text-lg font-medium text-yellow-800 text-center mb-2"><%= t('.vacation_time') %></h3>
        <div class="border-t border-yellow-200 my-2"></div>
        <p class="text-yellow-700 text-sm mb-2"><%= t('.you_can_still_create_an_account') %></p>
        <p class="text-yellow-700 text-sm mb-2"><%= link_to t('.if_you_have_an_account'), new_user_session_path, class: 'text-yellow-800 underline hover:text-yellow-900' %></p>
        <% if alumni_time? %>
          <p class="text-yellow-700 text-sm mb-2"><%= t('.if_you_are_alumni') %></p>
        <% end %>
      <% end %>
      <p class="text-yellow-700 text-sm"><%= t('.external_registration_available') %></p>
    </div>

    <%= form_with model: @user, scope: :user, url: user_registration_path, id: "new_user", skip_default_ids: false, class: "mt-8 space-y-6" do |form| %>
      <%= render 'auth/shared/error_messages', user: @user %>

      <div class="space-y-6">
        <div>
          <%= form.label :first_name, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :first_name, autocomplete: "given-name", required: true,
                              class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
        </div>

        <div>
          <%= form.label :last_name, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :last_name, autocomplete: "family-name", required: true,
                              class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
        </div>

        <div>
          <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true,
                               class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
        </div>

        <div>
          <%= form.label :email_confirmation, class: "block text-sm font-medium text-gray-700" %>
          <%= form.email_field :email_confirmation, required: true,
                               class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm",
                               data: { controller: "input", action: "paste->input#prevent" } %>
        </div>

        <div>
          <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :password, autocomplete: "new-password", required: true,
                                  minlength: Auth.password_length.begin,
                                  maxlength: Auth.password_length.end,
                                  class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
          <p class="mt-2 text-sm text-gray-500"><%= t('auth.shared.minimum_password_length', count: @minimum_password_length) %></p>
        </div>

        <div>
          <%= form.label :password_confirmation, class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true,
                                  class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
        </div>

        <div class="flex items-start">
          <div class="flex items-center h-5">
            <%= form.check_box :terms_of_service, required: true,
                               class: "h-4 w-4 text-slate-800 border-gray-300 rounded focus:ring-slate-800" %>
          </div>
          <div class="ml-2 text-sm">
            <%= form.label :terms_of_service, class: "font-medium text-gray-700" do %>
              <%= t('.i_have_read_and_accept') %>
              <%= link_to t('.terms_of_service'), legal_mentions_path, target: '_blank', class: "text-blue-600 hover:text-blue-800" %>
            <% end %>
          </div>
        </div>

        <%= form.submit t('defaults.signup'), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-800" %>
      </div>
    <% end %>

    <div class="mt-6"><%= render 'auth/shared/links' %></div>
  </div>
</div>
