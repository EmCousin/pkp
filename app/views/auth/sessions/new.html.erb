<% content_for :title, t('defaults.login') %>

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full bg-white p-8 rounded-lg">
    <div>
      <h1 class="mt-6 text-center text-3xl font-extrabold text-amber-500">
        <%= t('defaults.login') %>
      </h1>
      <div class="mt-2 border-b border-gray-300"></div>
    </div>

    <%= form_with model: @user,
                   scope: :user,
                   url: user_session_path,
                   id: "new_user",
                   skip_default_ids: false,
                   class: "space-y-6",
                  data: { turbo: false } do |form| %>
      <div class="space-y-6">
        <div>
          <%= form.label :email, class: "block text-sm font-medium text-gray-700" %>
          <%= form.email_field :email,
                               autofocus: true,
                               autocomplete: "email",
                               class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
        </div>

        <div>
          <%= form.label :password, class: "block text-sm font-medium text-gray-700" %>
          <%= form.password_field :password,
                                  autocomplete: "current-password",
                                  class: "mt-1 appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
        </div>

        <div class="flex items-center">
          <%= form.check_box :remember_me, class: "h-4 w-4 text-slate-800 focus:ring-slate-800 border-gray-300 rounded" %>
          <%= form.label :remember_me, class: "ml-2 block text-sm text-gray-900" %>
        </div>

        <%= form.submit t('defaults.login'), class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-800" %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= render 'auth/shared/links' %>
    </div>
  </div>
</div>
