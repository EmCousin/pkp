<div class="max-w-5xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t('.title') %></h1>
  <div class="grid gap-4 sm:grid-cols-2">
    <% @discovery_sessions.each do |discovery_session| %>
      <%= link_to [:coach, discovery_session], class: "block bg-white border border-gray-200 rounded-lg p-5 hover:border-blue-400" do %>
        <h2 class="font-semibold text-gray-900"><%= discovery_session.course.title %></h2>
        <p class="mt-1 text-sm text-gray-600"><%= l(discovery_session.starts_at, format: :event) %></p>
        <p class="mt-2 text-sm text-gray-500"><%= discovery_session.subscriptions.confirmed.size %> participants</p>
      <% end %>
    <% end %>
  </div>
</div>
