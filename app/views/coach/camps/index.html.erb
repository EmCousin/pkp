<div class="max-w-5xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t('.title') %></h1>
  <% if @camps.any? %>
    <div class="grid gap-4 sm:grid-cols-2">
      <% @camps.each do |camp| %>
        <%= link_to [:coach, camp], class: "block bg-white border border-gray-200 rounded-lg p-5 hover:border-blue-400" do %>
          <h2 class="font-semibold text-gray-900"><%= camp.title %></h2>
          <p class="mt-1 text-sm text-gray-600"><%= l(camp.starts_at, format: :long) %> — <%= l(camp.ends_at, format: :long) %></p>
          <p class="mt-2 text-sm text-gray-500"><%= t('.participants', count: camp.subscriptions.confirmed.size) %></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-gray-500 py-8"><%= t('.empty') %></p>
  <% end %>
</div>
