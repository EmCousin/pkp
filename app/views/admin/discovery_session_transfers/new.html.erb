<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-2xl text-center font-bold mb-4 text-amber-500"><%= t('.title') %></h1>
    <div class="border-b border-gray-200"></div>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-lg">
    <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
      <p class="font-semibold"><%= @subscription.member.full_name %></p>
      <p class="mt-1"><%= @course.title %></p>
      <p class="mt-1"><%= t('.current_date', date: @subscription.discovery_session.discovery_session_date) %></p>
      <p class="mt-3"><%= t('.payment_preserved') %></p>
    </div>

    <% if @subscription.errors.any? %>
      <div class="mb-6 rounded-md bg-red-50 p-4 text-sm text-red-700" role="alert">
        <%= @subscription.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <% if @available_dates.any? %>
      <%= form_with url: admin_subscription_discovery_session_transfer_path(@subscription),
                    scope: :discovery_session_transfer,
                    class: "space-y-6" do |form| %>
        <div>
          <%= form.label :occurs_on, t('.new_date'), class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :occurs_on,
                          @available_dates.map { |date| [l(date, format: :long), date.iso8601] },
                          {},
                          class: "mt-1 block w-full rounded-md border border-gray-300 bg-white px-3 py-2 shadow-sm focus:border-slate-800 focus:outline-none focus:ring-slate-800 sm:text-sm" %>
        </div>

        <div class="flex flex-col justify-end gap-3 pt-5 sm:flex-row">
          <%= link_to t('defaults.cancel'), [:admin, @subscription],
                      class: "inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
          <%= form.submit t('.submit'),
                          class: "inline-flex items-center justify-center rounded-md border border-transparent bg-slate-800 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-slate-900" %>
        </div>
      <% end %>
    <% else %>
      <p class="text-sm text-gray-700"><%= t('.no_available_dates') %></p>
      <div class="mt-6 flex justify-end">
        <%= link_to t('defaults.back'), [:admin, @subscription],
                    class: "inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>
</div>
