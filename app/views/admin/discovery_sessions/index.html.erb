<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900"><%= t('.title') %></h1>
      <p class="mt-1 text-sm text-gray-600"><%= t('.description') %></p>
    </div>
    <%= link_to t('.new'), new_admin_discovery_session_path,
        class: 'inline-flex shrink-0 items-center justify-center rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-900' %>
  </div>

  <div class="mb-6 rounded-lg border border-slate-200 bg-slate-50 p-4 shadow-sm">
    <%= form_with url: admin_discovery_sessions_path, method: :get,
        class: 'flex flex-col gap-4 sm:flex-row sm:items-end' do |form| %>
      <div class="flex-1">
        <%= form.label :date, DiscoverySession.human_attribute_name(:occurs_on), class: 'block text-sm font-medium text-gray-700 mb-1' %>
        <%= form.date_field :date, value: params[:date], class: 'block w-full rounded-md border-gray-300 px-3 py-2 shadow-sm focus:border-slate-800 focus:ring-slate-800' %>
      </div>
      <%= form.submit t('defaults.filter'), class: 'rounded-md bg-blue-600 px-5 py-2 font-medium text-white hover:bg-blue-700' %>
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg divide-y divide-gray-200">
    <% @discovery_sessions.each do |discovery_session| %>
      <div class="p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <%= link_to discovery_session.course.title, [:admin, discovery_session], class: "font-semibold text-gray-900 hover:text-blue-700" %>
          <p class="text-sm text-gray-600"><%= discovery_session.discovery_session_date %></p>
          <p class="text-sm text-gray-500"><%= discovery_session.subscriptions.confirmed.size %>/<%= discovery_session.capacity %> inscrits</p>
        </div>
        <div class="flex shrink-0 items-center justify-end gap-3">
          <%= link_to t('defaults.edit'), [:edit, :admin, discovery_session],
              class: "inline-flex items-center whitespace-nowrap text-sm text-blue-700" %>
          <%= button_to t('defaults.destroy'), [:admin, discovery_session], method: :delete,
              data: { turbo_confirm: t('.confirm_delete') },
              class: "inline-flex items-center whitespace-nowrap text-sm text-red-600" %>
        </div>
      </div>
    <% end %>
    <% if @discovery_sessions.empty? %>
      <p class="p-8 text-center text-gray-500"><%= t('.empty') %></p>
    <% end %>
  </div>

  <div class="mt-6"><%= paginate @discovery_sessions %></div>
</div>
