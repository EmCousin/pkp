<%= form_with model: [:admin, discovery_session], class: "space-y-6" do |form| %>
  <% if discovery_session.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
      <%= discovery_session.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <% if discovery_session.occurs_on? %>
    <div class="rounded-lg bg-amber-50 border border-amber-200 p-4">
      <p class="font-medium text-amber-900"><%= discovery_session.course.title %></p>
      <p class="mt-1 text-sm text-amber-800"><%= discovery_session.discovery_session_date %></p>
      <p class="mt-2 text-xs text-amber-700"><%= t('.automatic_occurrence') %></p>
    </div>
  <% else %>
    <div>
      <%= form.label :course_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.collection_select :course_id, Course.order(:weekday, :title), :id, :title, {},
          class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm bg-white" %>
    </div>
    <div>
      <%= form.label :starts_at, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.datetime_local_field :starts_at,
          class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
    </div>
  <% end %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
    <div>
      <%= form.label :capacity, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :capacity, min: 1,
          class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
    </div>
    <div>
      <%= form.label :price, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :price, min: 0, step: 0.01,
          class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
    </div>
  </div>
  <div class="flex flex-col gap-4">
    <label class="flex items-center gap-3"><%= form.switch :active %><span><%= DiscoverySession.human_attribute_name(:active) %></span></label>
    <label class="flex items-center gap-3"><%= form.switch :open %><span><%= DiscoverySession.human_attribute_name(:open) %></span></label>
  </div>
  <div class="flex flex-col sm:flex-row justify-end gap-3 pt-5">
    <%= link_to t('defaults.cancel'), admin_discovery_sessions_path,
        class: "inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-800" %>
    <%= form.submit class: "inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-800" %>
  </div>
<% end %>
