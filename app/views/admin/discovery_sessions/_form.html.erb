<%= form_with model: [:admin, discovery_session], class: "space-y-6" do |form| %>
  <% if discovery_session.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
      <%= discovery_session.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= form.label :course_id, class: "block text-sm font-medium text-gray-700" %>
    <%= form.collection_select :course_id, Course.order(:weekday, :title), :id, :title, {},
        class: "mt-1 block w-full rounded-md border-gray-300" %>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    <div>
      <%= form.label :starts_at, class: "block text-sm font-medium text-gray-700" %>
      <%= form.datetime_local_field :starts_at, class: "mt-1 block w-full rounded-md border-gray-300" %>
    </div>
    <div>
      <%= form.label :capacity, class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :capacity, min: 1, class: "mt-1 block w-full rounded-md border-gray-300" %>
    </div>
    <div>
      <%= form.label :price, class: "block text-sm font-medium text-gray-700" %>
      <%= form.number_field :price, min: 0, step: 0.01, class: "mt-1 block w-full rounded-md border-gray-300" %>
    </div>
  </div>
  <div class="flex flex-col gap-4">
    <label class="flex items-center gap-3"><%= form.switch :active %><span><%= DiscoverySession.human_attribute_name(:active) %></span></label>
    <label class="flex items-center gap-3"><%= form.switch :open %><span><%= DiscoverySession.human_attribute_name(:open) %></span></label>
  </div>
  <div class="flex justify-end gap-3">
    <%= link_to t('defaults.cancel'), admin_discovery_sessions_path, class: "px-4 py-2 rounded-md border border-gray-300" %>
    <%= form.submit class: "px-4 py-2 rounded-md bg-slate-800 text-white" %>
  </div>
<% end %>
