<div class="max-w-3xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= t('.title') %></h1>
  <p class="text-sm text-gray-600 mb-6"><%= t('.description', platform: @platform.name) %></p>

  <div class="bg-white shadow rounded-lg p-6">
    <%= form_with model: @platform, url: admin_platform_path, class: "space-y-6" do |form| %>
      <% if @platform.errors.any? %>
        <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
          <%= @platform.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= form.label :medical_certificate_validity_seasons, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :medical_certificate_validity_seasons, required: true, min: 1, step: 1,
            class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-slate-800 focus:border-slate-800 sm:text-sm" %>
        <p class="mt-2 text-sm text-gray-500"><%= t('.medical_certificate_validity_seasons_hint') %></p>
      </div>

      <div class="flex justify-end pt-5">
        <%= form.submit t('defaults.save'),
            class: "inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-slate-800 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-800" %>
      </div>
    <% end %>
  </div>
</div>
