<div class="mx-auto max-w-2xl py-8 px-4">
  <div class="rounded-lg bg-white p-6 shadow-sm">
    <h1 class="text-xl font-semibold text-gray-900"><%= t('.title') %></h1>
    <p class="mt-2 text-sm text-gray-600"><%= @subscription.description %></p>

    <% if @subscription.pennylane_invoice_error? %>
      <div class="mt-6 rounded-md bg-red-50 p-4 text-red-800">
        <p class="font-medium"><%= t('.failed') %></p>
        <p class="mt-1 text-sm"><%= @subscription.pennylane_invoice_error %></p>
      </div>
    <% elsif @subscription.pennylane_invoice_id? %>
      <div class="mt-6 rounded-md bg-green-50 p-4 text-green-800">
        <p class="font-medium"><%= t('.created', number: @subscription.pennylane_invoice_number) %></p>
        <p class="mt-1 text-sm"><%= t('.created_description') %></p>
      </div>
    <% else %>
      <div class="mt-6 rounded-md bg-blue-50 p-4 text-blue-800">
        <p class="font-medium"><%= t('.pending') %></p>
        <p class="mt-1 text-sm"><%= t('.pending_description') %></p>
      </div>
    <% end %>

    <div class="mt-6 flex flex-wrap gap-3">
      <% if @subscription.invoice.attached? %>
        <%= link_to t('defaults.download'),
                    rails_blob_path(@subscription.invoice, disposition: 'attachment'),
                    class: "inline-flex items-center rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
      <% end %>
      <%= button_to t('.retry'),
                    admin_subscription_invoice_path(@subscription),
                    method: :post,
                    class: "inline-flex items-center rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white hover:bg-green-700",
                    data: { turbo_submits_with: t('.retrying') } %>
      <%= link_to t('defaults.back'), admin_subscription_path(@subscription),
                  class: "inline-flex items-center rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
    </div>
  </div>
</div>
