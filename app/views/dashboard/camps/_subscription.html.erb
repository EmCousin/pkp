<% camp_subscription = member.subscriptions.not_archived.joins(:camps_subscription).find_by(camps_subscriptions: { camp_id: @camp.id }) %>
<% annual_subscription = member.annual_subscription_for(@camp.year) %>
<% annual_registration = member.annual_registration_for(@camp.year) %>

<% if camp_subscription %>
  <% completion_path = next_completion_step_path(camp_subscription) %>
  <div class="rounded-lg bg-white border border-gray-200 p-4">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="font-medium text-gray-900"><%= member.full_name %></p>
        <p class="text-xs text-gray-500"><%= Subscription.human_attribute_name(camp_subscription.status) %> - <%= number_to_currency(camp_subscription.fee, unit: '€') %></p>
      </div>
      <% if completion_path != dashboard_path || camp_subscription.cancellable? %>
        <div class="flex items-center gap-3">
          <% if completion_path != dashboard_path %>
            <%= link_to t('dashboard.event_subscription.resume'), completion_path, class: "text-sm font-medium text-blue-700" %>
          <% end %>
          <% if camp_subscription.cancellable? %>
            <% cancellation_path = camp_subscription.parent_subscription_id? ? dashboard_camp_subscription_path(@camp, camp_subscription) : dashboard_camp_registration_path(@camp, camp_subscription) %>
            <%= button_to t('.unsubscribe'), cancellation_path, method: :delete,
                class: "text-sm font-medium text-red-600",
                data: { turbo_confirm: t('.unsubscribe_confirm', member: member.full_name) } %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% elsif member.can_subscribe?(@camp) %>
  <% registration_path = annual_subscription ? dashboard_camp_subscriptions_path(@camp) : dashboard_camp_registrations_path(@camp) %>
  <% registration_params = annual_subscription ? { subscription_id: annual_subscription.id } : { member_id: member.id } %>
  <%= button_to registration_path, params: registration_params,
      class: "w-full rounded-lg px-4 py-3 text-left text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" do %>
    <span class="block"><%= t('.subscribe_with', member: member.full_name) %></span>
    <span class="block text-xs text-blue-100"><%= @camp.internal_for?(member) ? t('.internal_rate') : t('.external_rate') %> - <%= number_to_currency(@camp.price_for(member), unit: '€') %></span>
  <% end %>
<% else %>
  <div class="text-sm text-gray-500 bg-gray-50 rounded-lg px-4 py-3 border border-gray-200">
    <% if @camp.fully_booked? %>
      <%= t('.unavailability.full') %>
    <% elsif annual_registration && !@camp.open? %>
      <%= t('.unavailability.externals_only', member: member.full_name) %>
    <% elsif annual_registration && !annual_subscription %>
      <%= t('.unavailability.annual_pending', member: member.full_name) %>
    <% elsif !annual_registration && !@camp.open_to_externals? %>
      <%= t('.unavailability.students_only', member: member.full_name) %>
    <% else %>
      <%= t('.unavailability.unavailable', member: member.full_name) %>
    <% end %>
  </div>
<% end %>
