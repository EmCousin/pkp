<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900"><%= t('.title') %></h1>
      <p class="mt-2 text-gray-600"><%= t('.description') %></p>
    </div>
    <%= link_to t('.new_member'), new_dashboard_member_path(return_to: dashboard_members_path),
        class: "inline-flex justify-center rounded-lg bg-blue-600 px-4 py-3 text-sm font-semibold text-white hover:bg-blue-700" %>
  </div>

  <% if @members.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <% @members.each do |member| %>
        <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
          <div class="flex items-center gap-4">
            <% if member.avatar.attached? %>
              <%= image_tag member.avatar.variant(:mini), class: "h-16 w-16 rounded-full object-cover" %>
            <% else %>
              <div class="h-16 w-16 rounded-full bg-gray-100"></div>
            <% end %>
            <div class="min-w-0 flex-1">
              <h2 class="text-lg font-semibold text-gray-900"><%= member.full_name %></h2>
              <p class="text-sm text-gray-500"><%= l(member.birthdate, format: :long) %></p>
            </div>
          </div>
          <div class="mt-5 flex gap-3 border-t border-gray-100 pt-4">
            <%= link_to t('defaults.show'), [:dashboard, member], class: "text-sm font-medium text-blue-700 hover:text-blue-900" %>
            <%= link_to t('defaults.edit'), [:edit, :dashboard, member], class: "text-sm font-medium text-gray-700 hover:text-gray-900" %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 px-6 py-12 text-center">
      <p class="font-medium text-gray-900"><%= t('.empty') %></p>
      <p class="mt-2 text-sm text-gray-600"><%= t('.empty_description') %></p>
    </div>
  <% end %>
</div>
