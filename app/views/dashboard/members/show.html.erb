<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
  <div class="flex items-center justify-between gap-4 mb-6">
    <%= link_to t('defaults.back'), dashboard_members_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900" %>
    <%= link_to t('defaults.edit'), [:edit, :dashboard, @member], class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
  </div>

  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center gap-5">
      <% if @member.avatar.attached? %>
        <%= image_tag @member.avatar, class: "h-24 w-24 rounded-full object-cover" %>
      <% end %>
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= @member.full_name %></h1>
        <p class="mt-1 text-gray-600"><%= l(@member.birthdate, format: :long) %></p>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6 border-t border-gray-200 pt-6">
      <div>
        <h2 class="font-semibold text-gray-900"><%= t('.emergency_contact') %></h2>
        <p class="mt-2 text-sm text-gray-700"><%= @member.contact_name %></p>
        <p class="text-sm text-gray-500"><%= @member.contact_relationship %></p>
        <%= link_to @member.contact_phone_number, "tel:#{@member.contact_phone_number}", class: "text-sm text-blue-700" %>
      </div>
      <div>
        <h2 class="font-semibold text-gray-900"><%= t('.image_rights') %></h2>
        <p class="mt-2 text-sm text-gray-700"><%= @member.agreed_to_advertising_right? ? t('defaults.yes') : t('defaults.no') %></p>
      </div>
    </div>
  </div>

  <div class="mt-10 rounded-xl border border-red-200 bg-red-50 p-6">
    <h2 class="text-lg font-semibold text-red-900"><%= t('.danger_zone') %></h2>
    <p class="mt-2 text-sm text-red-800">
      <%= @member.destroyable? ? t('.destroy_description') : t('.tombstone_description') %>
    </p>
    <p class="mt-2 text-sm font-semibold text-red-900"><%= t('.irreversible') %></p>
    <%= button_to t('.destroy'), [:dashboard, @member], method: :delete,
        form: { class: "mt-5", data: { turbo_confirm: t('.destroy_confirmation', member: @member.full_name) } },
        class: "rounded-lg bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700" %>
  </div>
</div>
