<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="bg-white shadow sm:rounded-lg overflow-hidden">
    <% unless local_assigns[:hide_header] %>
      <div class="px-5 py-6 border-b border-gray-200">
        <h1 class="text-xl font-semibold text-gray-900"><%= discovery_session.course.title %></h1>
        <p class="mt-1 text-sm text-gray-600"><%= discovery_session.discovery_session_date %></p>
        <p class="mt-1 text-sm text-gray-500"><%= attendance_records.size + subscriptions.size %> participants</p>
      </div>
    <% end %>
    <div class="divide-y divide-gray-200">
      <%= render partial: 'shared/attendance_record', collection: attendance_records, locals: { namespace: } %>

      <% subscriptions.each do |subscription| %>
        <div class="p-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex min-w-0 items-center gap-3">
            <%= image_tag subscription.member.avatar, class: "h-11 w-11 rounded-full object-cover" %>
            <div class="min-w-0">
              <p class="font-medium text-gray-900"><%= subscription.member.full_name %></p>
              <p class="text-sm text-gray-500"><%= subscription.member.email %></p>
            </div>
          </div>
          <% attendance_path = namespace == :admin ? admin_discovery_session_subscription_path(discovery_session, subscription) : coach_discovery_session_subscription_path(discovery_session, subscription) %>
          <%= form_with model: subscription, url: attendance_path, method: :patch, data: { controller: 'form' }, class: 'w-full sm:w-auto' do |form| %>
            <div class="grid grid-cols-4 gap-1 sm:flex sm:gap-0" role="group" aria-label="<%= t('.attendance_status') %>">
              <%= form.radio_button :attendance_status, '', class: 'sr-only peer', data: { action: 'form#submit' } %>
              <%= form.label :attendance_status, value: '',
                             class: class_names(
                               'flex min-w-0 cursor-pointer items-center justify-center gap-1 rounded-l-md border px-2 py-2 text-xs font-semibold text-gray-700 transition sm:px-3 sm:text-sm',
                               'bg-gray-100 border-gray-300 opacity-60 grayscale' => subscription.attendance_status.present?,
                               'bg-gray-200 border-slate-800 ring-2 ring-slate-800 ring-offset-1' => subscription.attendance_status.blank?
                             ),
                             aria: { label: t('.not_recorded') } do %>
                <span class="sm:hidden" aria-hidden="true">•</span>
                <span class="hidden sm:inline"><%= t('.not_recorded') %></span>
              <% end %>
              <% Subscription.attendance_statuses.keys.each_with_index do |status, index| %>
                <% style = AttendanceRecord::STATUS_STYLES.fetch(status.to_sym) %>
                <%= form.radio_button :attendance_status, status, class: 'sr-only peer', data: { action: 'form#submit' } %>
                <%= form.label :attendance_status, value: status,
                               class: class_names(
                                 'flex min-w-0 cursor-pointer items-center justify-center gap-1 border px-2 py-2 text-xs font-semibold transition sm:px-3 sm:text-sm',
                                 style[:color],
                                 {
                                   'rounded-r-md' => index == Subscription.attendance_statuses.keys.size - 1,
                                   'opacity-60 grayscale' => subscription.attendance_status.to_s != status,
                                   'ring-2 ring-slate-800 ring-offset-1' => subscription.attendance_status.to_s == status
                                 }
                               ),
                               aria: { label: style[:label] } do %>
                  <span aria-hidden="true"><%= style[:emoji] %></span>
                  <span class="hidden sm:inline"><%= style[:label] %></span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if subscriptions.empty? %>
        <p class="p-8 text-center text-gray-500"><%= t('.empty') %></p>
      <% end %>
    </div>
  </div>
</div>
